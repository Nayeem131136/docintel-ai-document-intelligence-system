flowchart LR
    user([User's browser]) --> web["React web app<br/>(nginx, port 3000)"]
    web -- "/api (token auth)" --> api["Django REST API<br/>(gunicorn, port 8000)"]
    api --> db[("PostgreSQL<br/>documents, pages, invoices,<br/>issues, history, search index")]
    api --> files[("Uploaded files<br/>volume")]
    api -- "enqueue job after commit" --> redis[("Redis<br/>job queue")]
    redis --> worker["Celery worker<br/>(background processing)"]
    worker --> db
    worker --> files
    worker -- "text + prompt" --> llm["Groq LLM API<br/>(JSON mode)"]
    worker --> emb["Local embedding model<br/>(fastembed, CPU)"]
    worker --> ocr["Local OCR<br/>(RapidOCR)"]
    classDef store fill:#eef2ff,stroke:#4a5398,color:#1a1a2e
    classDef svc fill:#ecfdf8,stroke:#0f9783,color:#1a1a2e
    classDef ext fill:#fff7ed,stroke:#c2410c,color:#1a1a2e
    class db,files,redis store
    class web,api,worker,emb,ocr svc
    class llm ext
