erDiagram
    User ||--o{ Document : owns
    Document ||--o{ DocumentPage : "text per page or sheet"
    Document ||--o{ ExtractionResult : "1 to n invoices"
    Document ||--o{ ProcessingEvent : "processing history"
    Document ||--o{ ValidationIssue : "document-level flags"
    Document ||--o{ SearchChunk : "search index"
    Document ||--o{ CrossVerification : "document_a / document_b"
    ExtractionResult ||--o{ LineItem : has
    ExtractionResult ||--o{ ValidationIssue : "invoice-level flags"
    ExtractionResult ||--o{ CorrectionLog : "manual edits"
    ExtractionResult ||--o{ SearchChunk : "invoice summary"

    Document {
        uuid id PK
        string original_filename
        string file_type
        string sha256
        string status
        int progress
        int page_count
        int attempts
        datetime uploaded_at
        bigint processing_time_ms
    }
    DocumentPage {
        int page_number
        string source "digital, ocr, spreadsheet"
        text text
        float ocr_confidence
        json table
    }
    ExtractionResult {
        string invoice_number
        date invoice_date
        string supplier_name
        string customer_name
        string currency
        decimal subtotal
        decimal discount "negative, only if printed"
        decimal tax
        decimal total
        json confidence
        string method "llm, rules, manual"
        string review_status
        string dedupe_key
    }
    LineItem {
        text description
        decimal quantity
        decimal unit_price
        decimal amount
    }
    ValidationIssue {
        string code
        string severity
        string field
        text message
        bool resolved
    }
    CorrectionLog {
        string field
        text old_value
        text new_value
        text note
    }
    ProcessingEvent {
        string stage
        string outcome
        bigint duration_ms
    }
    CrossVerification {
        string check_type "pdf_pdf, pdf_excel"
        string outcome
        json details
    }
    SearchChunk {
        string kind "invoice, page"
        int page_number
        text text
        binary embedding
        string embedding_model
    }
