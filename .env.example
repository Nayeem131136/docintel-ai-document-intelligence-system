# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local mode (no Docker): leave DATABASE_URL empty -> SQLite is used.
# Docker mode: docker-compose.yml sets DATABASE_URL to PostgreSQL automatically.
DATABASE_URL=

# --- Redis / Celery ---
# Docker mode: docker-compose.yml sets REDIS_URL automatically.
REDIS_URL=redis://localhost:6379/0
# Local mode without Redis: run background tasks inline instead.
# CELERY_TASK_ALWAYS_EAGER=true

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- LLM (used from Phase 3) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=put-a-current-groq-model-name-here
