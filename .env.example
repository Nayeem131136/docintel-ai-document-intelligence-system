# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Local mode (no Docker): leave DATABASE_URL empty -> SQLite is used.
# Docker mode: docker-compose.yml sets DATABASE_URL to PostgreSQL automatically.
DATABASE_URL=

# --- Redis / Celery ---
# Docker mode: docker-compose.yml sets REDIS_URL automatically.
REDIS_URL=redis://localhost:6379/0
# Local mode without Redis: run background tasks inline instead.
# CELERY_TASK_ALWAYS_EAGER=true
# Max files per upload request and max runtime of one document (seconds).
# MAX_FILES_PER_UPLOAD=20
# CELERY_TASK_SOFT_TIME_LIMIT=7200

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- LLM extraction (Phase 3) ---
# Without a key and model the app still works using rule-based extraction (less accurate).
# Get a key at https://console.groq.com and pick a current model name from the Groq model list.
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=put-a-current-groq-model-name-here
# Optional tuning:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=3
# EXTRACTION_MAX_CHARS=30000
# LOW_OCR_CONFIDENCE=0.80
